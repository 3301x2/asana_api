# Get your Personal Access Token from: https://app.asana.com/0/my-apps
ASANA_PAT=your_personal_access_token_here

# Optional: Set your workspace GID (auto-detected if not set)
ASANA_WORKSPACE_GID=

# --- For sync_commits.py (GitHub-to-Asana automation) ---
# GitHub PAT with 'repo' scope: https://github.com/settings/tokens
GH_TOKEN=your_github_token_here

# Your GitHub username
GITHUB_OWNER=your_github_username

# Comma-separated repos to skip (optional)
SKIP_REPOS=
